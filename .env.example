NOTIFICATION_PORT=3003
TRACKING_PORT=3004
DISPATCH_PORT=3005

# Shared platform integration
NATS_URL=nats://localhost:4222
NATS_STREAM=truckmoov_events
DEFAULT_TENANT=default
JWT_SECRET=replace-me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# ntfy topic URL for 4xx/5xx error push alerts. Empty disables alerting.
# Public ntfy.sh topics are world-readable by anyone who guesses/finds the
# topic name — self-host ntfy, or set NTFY_ERROR_AUTH_TOKEN (ntfy access
# token) so the URL alone isn't enough to read alert contents.
NTFY_ERROR_TOPIC_URL=
NTFY_ERROR_AUTH_TOKEN=

NOTIFICATION_SERVICE_URL=http://localhost:3003
DISPATCH_SERVICE_URL=http://localhost:3005

# Dispatch durability
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truckmoov
POSTGRES_PASSWORD=truckmoov
POSTGRES_DB=truckmoov
POSTGRES_SSLMODE=disable
ROUTE_SOLVER_ADDR=localhost:50051

# Tracking state/cache
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# Notification transport (Meta WhatsApp Cloud API)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v23.0
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCOUNT_ENCRYPTION_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Notification SMS receipts (SMS is sent by the TS auth service's unified endpoint).
# Dotgo calls POST /notify/sms/webhook with ?token=; this secret validates it.
DOTGO_WEBHOOK_SECRET=

# Tracking ingest guardrails and retention
TELEMETRY_MAX_ACCURACY_M=500
TELEMETRY_MAX_SPEED_KPH=250
TRACKING_HISTORY_TTL_SECONDS=604800
TRACKING_LATEST_TTL_SECONDS=2592000
GPS_API_KEY=
# Dev only: accept ingest without GPS_API_KEY. Ignored when APP_ENV is production.
ALLOW_UNAUTHENTICATED_INGEST=

# Shared API protection
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Event bus signing. Must equal the TypeScript services' value. Without it every
# verified consumer rejects events.
EVENT_SIGNING_SECRET=
# Rollout only: accept events without a bus signature. Leave unset afterwards.
EVENT_ACCEPT_UNSIGNED=
