# syntax=docker/dockerfile:1.7
FROM golang:1.26-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
# Build for target runtime arch while keeping fast native build platform tooling.
RUN GOOS="${TARGETOS:-$(go env GOOS)}" \
    GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    CGO_ENABLED=0 go build -o /bin/tracking ./cmd/tracking

FROM gcr.io/distroless/base-debian13:nonroot@sha256:7fe4df6a4413adf5889960d345a28b4574aea0872ea47684c7244c8d88027dca
USER nonroot:nonroot
COPY --from=builder /bin/tracking /tracking
EXPOSE 3004
ENTRYPOINT ["/tracking"]
