# syntax=docker/dockerfile:1.7
FROM golang:1.26-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
# Build for target runtime arch while keeping fast native build platform tooling.
RUN GOOS="${TARGETOS:-$(go env GOOS)}" \
    GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    CGO_ENABLED=0 go build -o /bin/dispatch ./cmd/dispatch

FROM gcr.io/distroless/base-debian13:nonroot@sha256:7088bf1cdc94a65af4e0d5ad94518ed489a372dec1ece38ff4411c6c15fb5864
USER nonroot:nonroot
COPY --from=builder /bin/dispatch /dispatch
EXPOSE 3005
ENTRYPOINT ["/dispatch"]
